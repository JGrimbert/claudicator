@@ -0,0 +1,218 @@
+<script lang="ts">
+    import { onMount } from "svelte";
+    import { componentAnalysis, notifyTaskCreated } from "$lib/stores/agent";
+    import { readAnalysisStream } from "$lib/utils/analysisStream";
+    import { JgrCta, JgrPre } from "jgr-ui";
+
+    type History = { date: string; taskTitle: string; prUrl: string; commitUrl: string; branch: string };
+
+    let taskCreating = $state(false);
+    let taskDone = $state(false);
+    let history = $state<History | null>(null);
+
+    onMount(async () => {
+        const r = await fetch("/api/component-analysis");
+        if (!r.ok) return;
+        const data = await r.json();
+        if (data?.content && !$componentAnalysis.result)
+            componentAnalysis.update(s => ({ ...s, result: data.content }));
+        if (data?.history) history = data.history;
+    });
+
+    async function createTask() {
+        if (taskCreating || taskDone) return;
+        taskCreating = true;
+        try {
+            const res = await fetch("/api/component-analysis/task", { method: "POST" });
+            if (res.ok) {
+                const task = await res.json();
+                taskDone = true;
+                notifyTaskCreated(task?.id);
+            }
+        } finally {
+            taskCreating = false;
+        }
+    }
+
+    let logEl = $state<HTMLElement | null>(null);
+
+    async function analyze() {
+        componentAnalysis.update(s => ({ ...s, running: true, result: null, logs: [] }));
+        try {
+            const res = await fetch("/api/component-analysis", { method: "POST" });
+            if (!res.ok || !res.body) {
+                componentAnalysis.update(s => ({ ...s, running: false }));
+                return;
+            }
+            await readAnalysisStream(res, entry =>
+                componentAnalysis.update(s => ({ ...s, logs: [...s.logs, entry] }))
+            );
+        } finally {
+            const r = await fetch("/api/component-analysis");
+            if (r.ok) {
+                const data = await r.json();
+                componentAnalysis.update(s => ({ ...s, result: data?.content ?? null, running: false }));
+                if (data?.history) history = data.history;
+            } else {
+                componentAnalysis.update(s => ({ ...s, running: false }));
+            }
+        }
+    }
+
+    $effect(() => {
+        if ($componentAnalysis.logs.length && logEl) logEl.scrollTop = logEl.scrollHeight;
+    });
+
+    const spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";
+    let spinnerIdx = $state(0);
+    $effect(() => {
+        if (!$componentAnalysis.running) return;
+        const t = setInterval(() => { spinnerIdx = (spinnerIdx + 1) % spinner.length; }, 100);
+        return () => clearInterval(t);
+    });
+
+    function fmtDate(iso: string) {
+        return new Date(iso).toLocaleDateString("fr-FR", { day: "2-digit", month: "2-digit", year: "2-digit" });
+    }
+</script>
+
+<div class="wrap">
+    {#if $componentAnalysis.running}
+        <div class="status">
+            <span class="spin">{spinner[spinnerIdx]}</span>
+            Analyse architecture en cours…
+        </div>
+        <div class="logs" bind:this={logEl}>
+            {#each $componentAnalysis.logs.slice(-40) as log}
+                <div class="log-line" class:sys={log.type === "system"}>{log.line}</div>
+            {/each}
+        </div>
+    {:else if $componentAnalysis.result}
+        <div class="header">
+            <span class="done">✓ Analyse prête</span>
+            <div class="actions">
+                <button
+                    class="task-btn"
+                    class:done={taskDone}
+                    disabled={taskCreating || taskDone}
+                    onclick={createTask}
+                >
+                    {taskDone ? "✓ Tâche créée" : taskCreating ? "…" : "→ Créer tâche"}
+                </button>
+                <button class="re-btn" onclick={analyze}>↺ Relancer</button>
+            </div>
+        </div>
+        {#if history}
+            <div class="history-bar">
+                Précédente : <a href={history.commitUrl} target="_blank" rel="noopener">{history.taskTitle}</a>
+                <span class="history-date">— {fmtDate(history.date)}</span>
+            </div>
+        {/if}
+        <div class="result">
+            <JgrPre content={$componentAnalysis.result} maxLines={30} />
+        </div>
+    {:else}
+        <div class="empty">
+            {#if history}
+                <div class="history-bar">
+                    Dernière action : <a href={history.commitUrl} target="_blank" rel="noopener">{history.taskTitle}</a>
+                    <span class="history-date">— {fmtDate(history.date)}</span>
+                </div>
+            {/if}
+            <p class="hint">Analyse la structure des {44} composants Svelte.</p>
+            <p class="hint">Détecte les patterns visuels récurrents, propose une hiérarchie de dossiers et identifie les candidats jgr-ui agnostiques.</p>
+            <JgrCta label="Analyser composants" onclick={analyze} />
+        </div>
+    {/if}
+</div>
+
+<style>
+    .wrap {
+        display: flex;
+        flex-direction: column;
+        flex: 1;
+        min-height: 0;
+        padding: 0.5rem 0.75rem;
+        gap: 0.5rem;
+    }
+    .empty {
+        display: flex;
+        flex-direction: column;
+        gap: 0.75rem;
+        padding-top: 0.5rem;
+    }
+    .hint {
+        font-size: 0.65rem;
+        color: var(--text-muted);
+        line-height: 1.5;
+        margin: 0;
+    }
+    .status {
+        display: flex;
+        align-items: center;
+        gap: 0.5rem;
+        font-size: 0.65rem;
+        color: var(--text-secondary);
+        font-family: 'JetBrains Mono', monospace;
+        flex-shrink: 0;
+    }
+    .spin { color: var(--accent); }
+    .logs {
+        flex: 1;
+        min-height: 0;
+        overflow-y: auto;
+        font-family: 'JetBrains Mono', monospace;
+        font-size: 0.58rem;
+        color: var(--text-muted);
+        display: flex;
+        flex-direction: column;
+        gap: 0.1rem;
+    }
+    .log-line { white-space: pre-wrap; word-break: break-all; }
+    .log-line.sys { color: var(--text-dim, #333); }
+    .header {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        flex-shrink: 0;
+    }
+    .actions { display: flex; align-items: center; gap: 0.4rem; }
+    .history-bar {
+        font-size: 0.6rem;
+        color: var(--text-muted);
+        font-family: 'JetBrains Mono', monospace;
+        flex-shrink: 0;
+        border-left: 2px solid var(--border);
+        padding-left: 0.5rem;
+    }
+    .history-bar a { color: var(--accent); text-decoration: none; }
+    .history-bar a:hover { text-decoration: underline; }
+    .history-date { color: var(--text-dim, #444); }
+    .done { font-size: 0.62rem; color: #4caf50; font-family: 'JetBrains Mono', monospace; }
+    .task-btn {
+        background: none;
+        border: 1px solid var(--accent);
+        color: var(--accent);
+        font-size: 0.6rem;
+        font-family: 'JetBrains Mono', monospace;
+        padding: 0.2rem 0.5rem;
+        cursor: pointer;
+        border-radius: 2px;
+        transition: background 0.1s;
+    }
+    .task-btn:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 15%, transparent); }
+    .task-btn:disabled { opacity: 0.5; cursor: default; }
+    .task-btn.done { border-color: #4caf50; color: #4caf50; }
+    .re-btn {
+        background: none;
+        border: 1px solid var(--border);
+        color: var(--text-muted);
+        font-size: 0.6rem;
+        font-family: 'JetBrains Mono', monospace;
+        padding: 0.2rem 0.4rem;
+        cursor: pointer;
+        border-radius: 2px;
+    }
+    .re-btn:hover { border-color: var(--border-strong); color: var(--text-secondary); }
+    .result { flex: 1; min-height: 0; overflow-y: auto; }
+</style>
